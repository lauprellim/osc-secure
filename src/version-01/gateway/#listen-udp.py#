# listen-udp.py
# This listens on UDP for signals from the raspberry pi pico w.

import socket

HOST = '192.'
PORT = 9000

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind((HOST, PORT))

print('Listening on UDP port %d...' % PORT)

while True:
    data, addr = sock.recvfrom(4096)
    print('From %s:%d  length=%d' % (addr[0], addr[1], len(data)))
    print(data.hex())
    print('')
